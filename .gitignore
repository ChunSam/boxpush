# Godot 4+ engine cache and generated files
.godot/
/android/

# Godot 3 leftovers (kept so a stray import dir never lands in a commit)
.import/

# Export artifacts.
#
# export_presets.cfg is deliberately NOT ignored. It was, on the general
# principle that presets embed absolute paths and signing credentials — but this
# one embeds neither, and ignoring it meant the `*.xsb` non-resource filter had
# to be re-entered by hand on every machine. That filter is the difference
# between a build with levels and a build without, so it travels with the repo
# and is asserted by test_project_config.gd. Revisit if signing is ever added.
export.cfg
/build/
/export/

# Screens rendered by tools/shots.ps1 — for looking at now, not for keeping.
/shots/

# Imported translations (generated from CSV)
*.translation

# Mono / C# (unused today, but harmless to pre-empt)
.mono/
data_*/
mono_crash.*.json

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
