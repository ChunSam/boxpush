/export/

# Screens rendered by tools/shots.ps1 — for looking at now, not for keeping.
/shots/

# Imported translations (generated from CSV)
*.translation

# Mono / C# (unused today, but harmless to pre-empt)
.mono/
data_*/
mono_crash.*.json

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
